# Copier ce fichier vers .env pour le développement local.
# Ne jamais ajouter de secret réel dans ce fichier.

# development ou production
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Jetons : courts, renouvelables, révocables
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

FRONTEND_URL=http://localhost:4200
DEFAULT_FROM_EMAIL=Jefamora <noreply@localhost>

# Production uniquement (DJANGO_ENV=production)
# DJANGO_DEBUG=False
# DJANGO_SECURE_SSL_REDIRECT=True
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Jefamora <noreply@jefamora.sn>

# PostgreSQL local
POSTGRES_DB=jefamora_dev
POSTGRES_USER=jefamora_app
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200
